{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}{{ 'guiziweb_sylius_token.ui.adjust'|trans }} | {{ parent() }}{% endblock %}

{% block body %}
    <div class="page-wrapper">
        <div class="page-header mb-3">
            <h1 class="page-title">{{ 'guiziweb_sylius_token.ui.adjust'|trans }}</h1>
            <div class="text-muted">
                {{ wallet.customer.email ?? '' }} — {{ 'guiziweb_sylius_token.ui.balance'|trans }}: <strong>{{ balance }}</strong>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                {{ form_start(form) }}
                    {{ form_row(form.direction) }}
                    {{ form_row(form.amount) }}
                    {{ form_row(form.reason) }}
                    <button type="submit" class="btn btn-primary">{{ 'sylius.ui.save_changes'|trans }}</button>
                    <a href="{{ path('guiziweb_sylius_token_admin_wallet_index') }}" class="btn btn-link">{{ 'sylius.ui.cancel'|trans }}</a>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
