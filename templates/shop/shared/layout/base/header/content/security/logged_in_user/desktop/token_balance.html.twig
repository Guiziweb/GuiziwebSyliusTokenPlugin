{% set balance = guiziweb_token_balance() %}
{% if balance is not null %}
    <small aria-hidden="true" role="presentation" class="text-black px-1">|</small>
    <a href="{{ path('guiziweb_sylius_token_shop_account_tokens_index') }}" class="btn btn-transparent px-1 d-flex align-items-center gap-1">
        {{ ux_icon('tabler:coins') }}
        <span>{{ balance }}</span>
    </a>
{% endif %}
