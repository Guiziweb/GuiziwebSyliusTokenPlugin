<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="guiziweb_sylius_token.fixture.token" class="Guiziweb\SyliusTokenPlugin\Fixture\TokenFixture">
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument type="service" id="sylius.factory.product" />
            <argument type="service" id="sylius.factory.product_variant" />
            <argument type="service" id="sylius.factory.channel_pricing" />
            <argument type="service" id="sylius.repository.channel" />
            <argument type="service" id="sylius.repository.product" />
            <argument type="service" id="guiziweb_sylius_token.factory.tariff" />
            <argument type="service" id="guiziweb_sylius_token.repository.tariff" />
            <tag name="sylius_fixtures.fixture" />
        </service>

        <service id="guiziweb_sylius_token.repository.token_product" class="Guiziweb\SyliusTokenPlugin\Repository\TokenProductRepository" public="true">
            <argument type="service" id="doctrine" />
            <argument>%sylius.model.product_variant.class%</argument>
        </service>

        <service id="guiziweb_sylius_token.listener.menu.admin" class="Guiziweb\SyliusTokenPlugin\Menu\AdminMenuListener">
            <tag name="kernel.event_listener" event="sylius.menu.admin.main" />
        </service>
    </services>
</container>
