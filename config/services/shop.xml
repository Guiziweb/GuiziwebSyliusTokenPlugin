<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="guiziweb_sylius_token.listener.menu.shop_account" class="Guiziweb\SyliusTokenPlugin\Menu\AccountMenuListener">
            <tag name="kernel.event_listener" event="sylius.menu.shop.account" />
        </service>

        <service id="guiziweb_sylius_token.twig.runtime.token_balance" class="Guiziweb\SyliusTokenPlugin\Twig\TokenBalanceRuntime">
            <argument type="service" id="sylius.context.customer" />
            <argument type="service" id="guiziweb_sylius_token.wallet.consumer" />
            <tag name="twig.runtime" />
        </service>

        <service id="guiziweb_sylius_token.twig.extension.token_balance" class="Guiziweb\SyliusTokenPlugin\Twig\TokenBalanceExtension">
            <tag name="twig.extension" />
        </service>
    </services>
</container>
