<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="guiziweb_sylius_token.form.type.tariff" class="Guiziweb\SyliusTokenPlugin\Form\Type\TokenTariffType">
            <argument>%guiziweb_sylius_token.model.tariff.class%</argument>
            <argument type="collection">
                <argument>sylius</argument>
            </argument>
            <tag name="form.type" />
        </service>

        <service id="guiziweb_sylius_token.form.type.admin.wallet_adjustment" class="Guiziweb\SyliusTokenPlugin\Form\Type\Admin\WalletAdjustmentType">
            <tag name="form.type" />
        </service>

        <service id="Guiziweb\SyliusTokenPlugin\Controller\Admin\WalletAdjustmentController" public="true">
            <argument type="service" id="guiziweb_sylius_token.repository.wallet" />
            <argument type="service" id="guiziweb_sylius_token.wallet.operator" />
            <argument type="service" id="router" />
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

        <service id="guiziweb_sylius_token.provider.current_wallet" class="Guiziweb\SyliusTokenPlugin\Provider\CurrentWalletProvider" public="true">
            <argument type="service" id="request_stack" />
            <argument type="service" id="guiziweb_sylius_token.repository.wallet" />
        </service>
    </services>
</container>
