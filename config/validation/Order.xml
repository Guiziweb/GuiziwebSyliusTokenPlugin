<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/constraint-mapping/constraint-mapping-1.0.xsd">
    <class name="Sylius\Component\Core\Model\Order">
        <constraint name="Guiziweb\SyliusTokenPlugin\Validator\Constraints\OrderPayableWithTokens">
            <option name="groups">
                <value>sylius_checkout_address</value>
                <value>sylius_checkout_select_shipping</value>
                <value>sylius_checkout_select_payment</value>
                <value>sylius_checkout_complete</value>
            </option>
        </constraint>
    </class>
</constraint-mapping>
