<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="guiziweb_sylius_token.behat.context.setup.token" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Context\Setup\TokenContext" public="true">
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument type="service" id="guiziweb_sylius_token.wallet.provider" />
            <argument type="service" id="guiziweb_sylius_token.wallet.operator" />
            <argument type="service" id="sylius.behat.shared_storage" />
            <argument type="service" id="sylius_abstraction.state_machine" />
            <argument type="service" id="guiziweb_sylius_token.factory.price" />
        </service>

        <service id="guiziweb_sylius_token.behat.context.ui.shop.token_balance" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Context\Ui\Shop\TokenBalanceContext" public="true">
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument type="service" id="sylius.context.customer" />
            <argument type="service" id="guiziweb_sylius_token.wallet.consumer" />
        </service>
        <service id="guiziweb_sylius_token.behat.page.admin.wallet.adjust" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Page\Admin\Wallet\AdjustPage" public="true">
            <argument type="service" id="behat.mink.default_session" />
            <argument type="service" id="behat.mink.parameters" />
            <argument type="service" id="router" />
        </service>

        <service id="guiziweb_sylius_token.behat.page.shop.account.token_history" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Page\Shop\Account\TokenHistoryPage" public="true">
            <argument type="service" id="behat.mink.default_session" />
            <argument type="service" id="behat.mink.parameters" />
            <argument type="service" id="router" />
        </service>

        <service id="guiziweb_sylius_token.behat.context.ui.shop.token_history" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Context\Ui\Shop\TokenHistoryContext" public="true">
            <argument type="service" id="guiziweb_sylius_token.behat.page.shop.account.token_history" />
        </service>

        <service id="guiziweb_sylius_token.behat.page.admin.price.index" class="Sylius\Behat\Page\Admin\Crud\IndexPage" parent="sylius.behat.page.admin.crud.index" public="true">
            <argument type="string">guiziweb_sylius_token_admin_price_index</argument>
        </service>

        <service id="guiziweb_sylius_token.behat.page.admin.price.create" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Page\Admin\Price\CreatePage" parent="sylius.behat.page.admin.crud.create" public="true">
            <argument type="string">guiziweb_sylius_token_admin_price_create</argument>
        </service>

        <service id="guiziweb_sylius_token.behat.context.ui.admin.managing_token_prices" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Context\Ui\Admin\ManagingTokenPricesContext" public="true">
            <argument type="service" id="guiziweb_sylius_token.behat.page.admin.price.index" />
            <argument type="service" id="guiziweb_sylius_token.behat.page.admin.price.create" />
            <argument type="service" id="sylius.behat.notification_checker.admin" />
            <argument type="service" id="guiziweb_sylius_token.repository.price" />
            <argument type="service" id="doctrine.orm.entity_manager" />
        </service>

        <service id="guiziweb_sylius_token.behat.page.admin.pack.index" class="Sylius\Behat\Page\Admin\Crud\IndexPage" parent="sylius.behat.page.admin.crud.index" public="true">
            <argument type="string">guiziweb_sylius_token_admin_token_product_index</argument>
        </service>

        <service id="guiziweb_sylius_token.behat.page.admin.pack.create" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Page\Admin\Pack\CreatePage" parent="sylius.behat.page.admin.crud.create" public="true">
            <argument type="string">guiziweb_sylius_token_admin_token_product_create</argument>
        </service>

        <service id="guiziweb_sylius_token.behat.page.admin.pack.update" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Page\Admin\Pack\UpdatePage" parent="sylius.behat.page.admin.crud.update" public="true">
            <argument type="string">guiziweb_sylius_token_admin_token_product_update</argument>
        </service>

        <service id="guiziweb_sylius_token.behat.context.ui.admin.creating_token_pack" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Context\Ui\Admin\CreatingTokenPackContext" public="true">
            <argument type="service" id="guiziweb_sylius_token.behat.page.admin.pack.create" />
            <argument type="service" id="guiziweb_sylius_token.behat.page.admin.pack.update" />
            <argument type="service" id="guiziweb_sylius_token.behat.page.admin.pack.index" />
            <argument type="service" id="sylius.repository.product_variant" />
            <argument type="service" id="doctrine.orm.entity_manager" />
        </service>

        <service id="guiziweb_sylius_token.behat.page.admin.wallet.history" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Page\Admin\Wallet\HistoryPage" public="true">
            <argument type="service" id="behat.mink.default_session" />
            <argument type="service" id="behat.mink.parameters" />
            <argument type="service" id="router" />
        </service>

        <service id="guiziweb_sylius_token.behat.page.admin.customer.show" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Page\Admin\Customer\ShowPage" public="true">
            <argument type="service" id="behat.mink.default_session" />
            <argument type="service" id="behat.mink.parameters" />
            <argument type="service" id="router" />
        </service>

        <service id="guiziweb_sylius_token.behat.context.ui.admin.browsing_token_history" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Context\Ui\Admin\BrowsingTokenHistoryContext" public="true">
            <argument type="service" id="guiziweb_sylius_token.behat.page.admin.wallet.history" />
            <argument type="service" id="guiziweb_sylius_token.behat.page.admin.customer.show" />
            <argument type="service" id="guiziweb_sylius_token.wallet.provider" />
            <argument type="service" id="doctrine.orm.entity_manager" />
        </service>

        <service id="guiziweb_sylius_token.behat.context.ui.admin.adjusting_token_balance" class="Tests\Guiziweb\SyliusTokenPlugin\Behat\Context\Ui\Admin\AdjustingTokenBalanceContext" public="true">
            <argument type="service" id="guiziweb_sylius_token.behat.page.admin.wallet.adjust" />
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument type="service" id="guiziweb_sylius_token.wallet.consumer" />
            <argument type="service" id="guiziweb_sylius_token.wallet.provider" />
            <argument type="service" id="sylius.behat.shared_storage" />
            <argument type="service" id="sylius.behat.notification_checker.admin" />
        </service>
    </services>
</container>
